    },
    "dark": {
      "canvas": "#0B051D",
      "surface-subtle": "#161028",
      "surface-blush": "#26182D",
      "surface-elevated": "#1D1632",
      "surface-glass": "rgba(31, 23, 50, 0.76)",
      "surface-dark": "#1D1632",
      "wash-start": "#2C2050",
      "wash-mid": "#45213D",
      "wash-end": "#0B051D",
      "ink-primary": "#F6F3FA",
      "ink-secondary": "#C6BCD2",

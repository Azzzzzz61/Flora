      "cta-primary-bg": "#0B051D",
      "cta-primary-fg": "#FFFFFF",
      "cta-primary-pressed": "#1E1636",
      "accent-iris": "#5B3FD9",
      "accent-iris-soft": "#F2EEFF",
      "disabled-bg": "#F2F0F5",
      "disabled-ink": "#767080",
      "border-hairline": "#EFEBF2",
      "border-card": "#E9E5EE",
      "border-control": "#D4CEDC",
      "border-focus": "#0B051D",
      "border-glass": "rgba(255, 255, 255, 0.90)",
      "success-fg": "#156B40",

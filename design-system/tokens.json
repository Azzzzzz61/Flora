{
  "meta": {
    "name": "Flora Design System",
    "version": "2.2.0",
    "scope": "pure-visual-system",
    "defaultSeason": "spring",
    "unit": "logical-px",
    "wechatUnitRule": "字体、图标、顶部胶囊对齐及固定底栏高度使用 px；流式容器宽度与区块留白可按 375px 基准换算 rpx（1px = 2rpx）"
  },
  "seasonalWash": {
    "rule": "四季/花期切换仅替换 wash-start 与 wash-mid 两个顶部氛围 Token，不改动主画布、品牌柔粉、主按钮及语义状态色；设计出稿默认使用 spring。",
    "spring": {
      "label": "春 · 樱雾粉紫（默认）",
      "light": { "wash-start": "#CFC8EA", "wash-mid": "#F3C8DC", "wash-end": "#FFFFFF" },
      "dark": { "wash-start": "#2C2050", "wash-mid": "#45213D", "wash-end": "#0B051D" }
    },
    "summer": {
      "label": "夏 · 晴空薄荷",
      "light": { "wash-start": "#C8E4EC", "wash-mid": "#D4ECDD", "wash-end": "#FFFFFF" },
      "dark": { "wash-start": "#193245", "wash-mid": "#1B3A32", "wash-end": "#0B051D" }
    },
    "autumn": {
      "label": "秋 · 桂影暖杏",
      "light": { "wash-start": "#F3D5B8", "wash-mid": "#F2D0D6", "wash-end": "#FFFFFF" },
      "dark": { "wash-start": "#462E20", "wash-mid": "#452531", "wash-end": "#0B051D" }
    },
    "winter": {
      "label": "冬 · 初雪冷莓",
      "light": { "wash-start": "#D5DCEF", "wash-mid": "#E7D4E8", "wash-end": "#FFFFFF" },
      "dark": { "wash-start": "#212946", "wash-mid": "#372342", "wash-end": "#0B051D" }
    }
  },
  "themes": {
    "light": {
      "canvas": "#FFFFFF",
      "surface-subtle": "#F6F6F8",
      "surface-blush": "#FFF2F6",
      "surface-elevated": "#FFFFFF",
      "surface-glass": "rgba(255, 255, 255, 0.78)",
      "surface-dark": "#0B051D",
      "wash-start": "#CFC8EA",
      "wash-mid": "#F3C8DC",
      "wash-end": "#FFFFFF",
      "ink-primary": "#0B051D",
      "ink-secondary": "#5E5868",

      "dock-active-pill": "#30274A"
    }
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Hiragino Sans GB\", \"Noto Sans SC\", \"Segoe UI\", sans-serif",
    "scale": {
      "title-large": { "label": "页面大标题", "size": 26, "lineHeight": 34, "weight": 700, "tracking": -0.4 },
      "price-lg": { "label": "重点金额", "size": 24, "lineHeight": 30, "weight": 700, "tracking": -0.3, "tabular": true },
      "section": { "label": "分组标题", "size": 20, "lineHeight": 28, "weight": 700, "tracking": -0.2 },
      "subheading": { "label": "次级标题", "size": 17, "lineHeight": 24, "weight": 600, "tracking": -0.1 },
      "item": { "label": "条目主标题", "size": 16, "lineHeight": 23, "weight": 600, "tracking": 0 },
      "price-row": { "label": "列表金额", "size": 16, "lineHeight": 22, "weight": 700, "tracking": 0, "tabular": true },
      "button": { "label": "按钮文字", "size": 15, "lineHeight": 20, "weight": 600, "tracking": 0 },
      "body": { "label": "正文", "size": 15, "lineHeight": 23, "weight": 400, "tracking": 0 },
      "meta": { "label": "辅助信息", "size": 13, "lineHeight": 19, "weight": 400, "tracking": 0 },
      "label": { "label": "标签 / 徽章", "size": 12, "lineHeight": 16, "weight": 600, "tracking": 0.1 },
      "tab": { "label": "导航标签", "size": 11, "lineHeight": 14, "weight": 600, "tracking": 0.1 },
      "caption": { "label": "图注 / 补充说明", "size": 11, "lineHeight": 16, "weight": 400, "tracking": 0 }
    }
  },
  "space": {
    "scale": [4, 8, 12, 16, 20, 24, 32, 40, 56, 72],
    "pageX": 20,
    "pageXCompact": 16,
    "cardPad": 16,
    "cardPadLarge": 20,
    "sectionGap": 24,
    "gridGap": 12
  },
  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "dock": 32,
    "pill": 999
  },
  "elevation": {
    "light": {
      "none": "none",
      "card": "0 2px 10px rgba(11, 5, 29, 0.04)",
      "glass": "0 8px 24px rgba(11, 5, 29, 0.07)",
      "dock": "0 10px 30px rgba(11, 5, 29, 0.11)",
      "sheet": "0 -12px 36px rgba(11, 5, 29, 0.16)"
    },
    "dark": {
      "none": "none",
      "card": "0 2px 12px rgba(0, 0, 0, 0.28)",
      "glass": "0 8px 28px rgba(0, 0, 0, 0.36)",
      "dock": "0 12px 34px rgba(0, 0, 0, 0.48)",
      "sheet": "0 -14px 40px rgba(0, 0, 0, 0.56)"
    }
  },
  "size": {
    "ctaPrimary": 52,
    "searchBar": 46,
    "filterPill": 40,
    "touchMin": 44,
    "dockHeight": 62,
    "iconNav": 20,
    "swatch": 32
  },
  "motion": {
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "pressMs": 160,
    "glideMs": 280,
    "sheetMs": 340,
    "pressScale": 0.98
  },
  "zIndex": {
    "base": 0,
    "sticky": 20,
    "dock": 40,
    "scrim": 60,
    "sheet": 70,
    "toast": 90
  }
}
